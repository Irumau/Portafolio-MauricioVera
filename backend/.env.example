# Copiá este archivo como .env y completá los valores.
# En producción, estas variables se cargan en el panel del hosting (no se sube ningún .env).

# ── Servidor ──────────────────────────────
PORT=3000
NODE_ENV=development            # en producción: production

# ── Base de datos (Turso / libSQL) ────────
TURSO_DATABASE_URL=file:local.db   # en producción: libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=                  # vacío en local; en producción: turso db tokens create <base>

# ── Autenticación ─────────────────────────
JWT_SECRET=                     # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=2h

# Solo para el script seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Imágenes (Cloudinary) ─────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
MAX_UPLOAD_MB=2

# ── CORS: URL del frontend ────────────────
CLIENT_URL=http://localhost:5173   # en producción: https://tu-portafolio.vercel.app
